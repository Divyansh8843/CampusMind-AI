# Public client config only — never put secrets in VITE_* variables
VITE_API_BASE_URL=http://localhost:3000
VITE_GOOGLE_CLIENT_ID=replace_with_google_oauth_client_id

# UI-only guide + preloader tuning
VITE_STUDENT_ALLOWED_DOMAINS=.ac.in,.edu.in,.edu
VITE_ALUMNI_ALLOWED_DOMAINS=gmail.com
VITE_PRELOADER_MS=1800

# Production: use HTTPS API origin
# VITE_API_BASE_URL=https://api.yourdomain.com
