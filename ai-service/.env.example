ENV=development
INTERNAL_API_KEY=replace_with_shared_internal_key
AI_REQUIRE_AUTH=true

# Comma-separated hostnames allowed for remote document fetch (SSRF protection)
AI_ALLOWED_DOWNLOAD_HOSTS=res.cloudinary.com,localhost,127.0.0.1
SERVER_PUBLIC_URL=http://localhost:3000

# LLM provider keys (configure at least one backend)
LLM_PROVIDER=auto
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.2-3b-instruct
OPENROUTER_FALLBACK_MODELS=google/gemma-3-4b-it
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OLLAMA_BASE_URL=http://127.0.0.1:11434
