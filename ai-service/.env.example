ENV=development
INTERNAL_API_KEY=replace_with_shared_internal_key
AI_REQUIRE_AUTH=true

# Comma-separated hostnames allowed for remote document fetch (SSRF protection)
AI_ALLOWED_DOWNLOAD_HOSTS=res.cloudinary.com,localhost,127.0.0.1
SERVER_PUBLIC_URL=http://localhost:3000

# LLM provider keys (configure at least one backend in rag_chain / env)
OPENAI_API_KEY=
GROQ_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434
