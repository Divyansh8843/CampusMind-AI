apiVersion: v1
kind: Secret
metadata:
  name: app-secrets
type: Opaque
stringData:
  # ⚠️ REMOVE THIS FILE FROM GIT BEFORE COMMITTING (It is safely ignored if you name it correctly)
  # IMPORTANT: In stringData, you can write the values normally (no base64 encoding needed).
  
  # Server Secrets
  MONGO_URI: "mongodb+srv://<replace_with_your_user>:<replace_with_your_password>@cluster0.mongodb.net/campusmind?retryWrites=true&w=majority"
  REDIS_URL: "redis://<your-redis-endpoint>:6379"
  JWT_SECRET: "your_very_long_secure_jwt_secret"
  GOOGLE_CLIENT_ID: "your_google_oauth_client_id"
  INTERNAL_API_KEY: "your_secret_key_for_microservice_auth"
  
  # AI Service Secrets
  OPENROUTER_API_KEY: "your_openrouter_api_key_here"
  OPENAI_API_KEY: "your_openai_api_key_here"
