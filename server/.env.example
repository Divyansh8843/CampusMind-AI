PORT=3000
NODE_ENV=development

# Database (either name works)
MONGO_URI=mongodb://127.0.0.1:27017/campusmind
MONGODB_URI=mongodb://127.0.0.1:27017/campusmind

# Auth
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars
GOOGLE_CLIENT_ID=replace_with_google_oauth_client_id
CLIENT_URL=http://localhost:5173
SERVER_PUBLIC_URL=http://localhost:3000

# AI microservice (must match ai-service INTERNAL_API_KEY)
AI_SERVICE_URL=http://127.0.0.1:8000
INTERNAL_API_KEY=replace_with_shared_internal_key
AI_TIMEOUT_MS=75000
AI_MAX_RETRIES=2

# Rate limits
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=30
MENTORSHIP_EMAIL_LIMIT=5

# Uploads
MAX_UPLOAD_MB=20
RESUME_MAX_UPLOAD_MB=5
JSON_BODY_LIMIT=10mb
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FALLBACK_TO_LOCAL=true

# Redis (optional cache)
REDIS_URL=redis://127.0.0.1:6379
REDIS_TLS_REJECT_UNAUTHORIZED=true

# Email (mentorship relay)
EMAIL_USER=
EMAIL_PASS=

# Stripe (optional)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=

# India-wide student access domains (comma-separated)
COLLEGE_ALLOWED_DOMAINS=.ac.in,.edu.in,.edu
ALUMNI_ALLOWED_DOMAINS=gmail.com
COLLEGE_DOMAIN=
ALUMNI_DOMAIN=
ADMIN_EMAILS=admin@example.com

# Alumni verification
ALLOWED_ALUMNI_COURSES=b.tech,btech,bca,mca,mba,m.tech,b.sc,m.sc,bba,bcom
ALLOWED_ALUMNI_BRANCHES=cse,it,ece,ee,me,ce,aiml,eee,civil,mechanical
